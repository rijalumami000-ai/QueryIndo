[Unit]
Description=QUERYINDO Go Backend API Service
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/queryindo/backend
ExecStart=/var/www/queryindo/backend/server
Restart=always
RestartSec=5s
EnvironmentFile=/var/www/queryindo/backend/.env

# Optimization & Resource limits
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
