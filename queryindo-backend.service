[Unit]
Description=QUERYINDO Go Backend API Service
After=network.target postgresql.service

[Service]
Type=simple
User=Rijalumami
Group=Rijalumami
WorkingDirectory=/var/www/queryindo/backend
ExecStart=/var/www/queryindo/backend/queryindo-backend
Restart=always
RestartSec=5s
EnvironmentFile=/var/www/queryindo/backend/.env

# Security Hardening & Sandboxing
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectHome=read-only

# Optimization & Resource limits
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

