  <!-- Global Instant Event Delegation Bridge -->
  <script is:inline>
    function toggleSearchOverlay() {
      const bar = document.getElementById('search-overlay-bar');
      const input = document.getElementById('search-input');
      if (bar) {
        const isHidden = bar.style.display === 'none' || !bar.style.display;
        bar.style.display = isHidden ? 'block' : 'none';
        if (isHidden && input) {
          setTimeout(() => input.focus(), 60);
          if (input.value.trim()) {
            const preview = document.getElementById('search-preview-dropdown');
            if (preview) preview.style.display = 'block';
          }
        } else {
          const preview = document.getElementById('search-preview-dropdown');
          if (preview) preview.style.display = 'none';
        }
      }
    }

    function closeSearchOverlay() {
      const bar = document.getElementById('search-overlay-bar');
      const preview = document.getElementById('search-preview-dropdown');
      if (bar) bar.style.display = 'none';
      if (preview) preview.style.display = 'none';
    }

    window.toggleSearchOverlay = toggleSearchOverlay;
    window.closeSearchOverlay = closeSearchOverlay;

    function openCategoryDrawer() {
      const drawer = document.getElementById('category-drawer-overlay');
      if (drawer) {
        drawer.style.display = 'block';
        document.body.classList.add('modal-open');
        document.body.style.overflow = 'hidden';
        const filterInput = document.getElementById('drawer-search-filter');
        if (filterInput) setTimeout(() => filterInput.focus(), 60);
      }
    }

    function closeCategoryDrawer() {
      const drawer = document.getElementById('category-drawer-overlay');
      if (drawer) {
        drawer.style.display = 'none';
        document.body.classList.remove('modal-open');
        document.body.style.overflow = '';
      }
    }

    window.addEventListener('open-category-drawer', openCategoryDrawer);
    window.addEventListener('close-category-drawer', closeCategoryDrawer);

    // Live search filter inside drawer
    document.addEventListener('input', function(e) {
      if (e.target && e.target.id === 'drawer-search-filter') {
        const q = e.target.value.toLowerCase().trim();
        const groups = document.querySelectorAll('#drawer-categories-tree .directory-col-group');
        groups.forEach(group => {
          if (!q) {
            group.style.display = '';
            group.querySelectorAll('.directory-subcat-link').forEach(link => link.style.display = '');
            return;
          }
          const catTitle = group.querySelector('.directory-cat-title')?.textContent?.toLowerCase() || '';
          let hasMatch = catTitle.includes(q);
          const links = group.querySelectorAll('.directory-subcat-link');
          links.forEach(link => {
            const subName = link.getAttribute('data-subname') || link.textContent?.toLowerCase() || '';
            const subMatch = subName.includes(q);
            link.style.display = subMatch || hasMatch ? '' : 'none';
            if (subMatch) hasMatch = true;
          });
          group.style.display = hasMatch ? '' : 'none';
        });
      }
    });

    document.addEventListener('click', function(e) {
      const target = e.target;
      if (!target) return;

      // 1. Hamburger Drawer Open
      if (target.closest('#btn-hamburger-menu, .btn-hamburger-menu, [data-open-drawer]')) {
        e.preventDefault();
        openCategoryDrawer();
        return;
      }

      // 1b. Hamburger Drawer Close
      if (target.closest('#btn-drawer-close, .btn-drawer-close')) {
        e.preventDefault();
        closeCategoryDrawer();
        return;
      }

      // Close drawer if clicking outside panel
      if (target.id === 'category-drawer-overlay') {
        closeCategoryDrawer();
        return;
      }

      // 2. Search Toggle
      if (target.closest('#btn-search-toggle, .btn-search-toggle, #btn-search-trigger, .btn-search-trigger, [data-search-trigger]')) {
        e.preventDefault();
        toggleSearchOverlay();
        return;
      }
      if (target.closest('#btn-search-close, .btn-search-close')) {
        e.preventDefault();
        closeSearchOverlay();
        return;
      }

      // 3. User Auth & Profile Modal
      if (target.closest('#dropdown-auth-action-btn, #m-user-auth-btn, .btn-login, [data-open-auth]')) {
        e.preventDefault();
        const dropdown = document.getElementById('user-avatar-dropdown');
        if (dropdown) dropdown.style.display = 'none';
        window.dispatchEvent(new CustomEvent('open-auth-modal'));
        return;
      }

      // 4. Bookmarks Drawer
      if (target.closest('#dropdown-bookmarks-btn, #bookmarks-btn, [data-open-bookmarks]')) {
        e.preventDefault();
        const dropdown = document.getElementById('user-avatar-dropdown');
        if (dropdown) dropdown.style.display = 'none';
        window.dispatchEvent(new CustomEvent('open-bookmarks-drawer'));
        return;
      }

      // 6. Article Card Click -> Open Article Reader Modal
      if (!target.closest('button, input, select, textarea, .btn-bookmark, .tag-badge, .cat-pill, .btn-lang, .dropdown-item, .cat-nav-item, .directory-cat-title, .directory-subcat-link')) {
        const card = target.closest('[data-article-slug], [data-slug], [data-article-id], [data-id], .hero-card, .trending-item, .matrix-card, .bento-featured-card, .feed-card, .article-card');
        if (card) {
          const slug = card.getAttribute('data-article-slug') || card.getAttribute('data-slug') || card.getAttribute('data-article-id') || card.getAttribute('data-id');
          if (slug) {
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('open-article-reader', { detail: { slugOrId: slug } }));
          }
        }
      }
    }, false);

    window.addEventListener('keydown', function(e) {
      if ((e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
        e.preventDefault();
        toggleSearchOverlay();
      }
      if (e.key === 'Escape') {
        closeCategoryDrawer();
        closeSearchOverlay();
      }
    });
  </script>

  <script src="../client-main.ts"></script>
