---
import BaseLayout from '../layouts/BaseLayout.astro';
import ByteShortsReel from '../components/islands/ByteShortsReel';
import ArticleReaderModal from '../components/islands/ArticleReaderModal';
import CategoryDrawer from '../components/islands/CategoryDrawer';
import BookmarksDrawer from '../components/islands/BookmarksDrawer';
import UserAuthModal from '../components/islands/UserAuthModal';
import { CATEGORIES, MASTER_TAXONOMY } from '../data/mockNews';

const categories14 = CATEGORIES.filter(c => c.id !== 'all');
---

<BaseLayout>
<div id="app">
    <!-- Main Navigation Header (QUERYINDO Unified Navigation System) -->
    <header class="navbar" id="site-header">
      <div class="navbar-inner-wrapper">
        <div class="navbar-content">
          <!-- 1. Leftmost Edge: Hamburger Menu Button ONLY (Mentok Paling Kiri) -->
          <div class="navbar-left-edge">
            <button id="btn-hamburger-menu" class="btn-hamburger-menu" title="Buka Direktori Seluruh Kanal Berita (14 Kanal)" aria-label="Menu Direktori">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
          </div>

          <!-- 2. Center Editorial Spine: Brand Logo + All 14 Categories in 1 Prominent Unified Nav -->
          <div class="navbar-center-spine">
            <a href="#" class="brand-logo" id="logo-btn" aria-label="QueryIndo — Portal Berita Teknologi Indonesia">
              <div class="brand-emblem-wrap">
                <svg class="brand-emblem-svg" viewBox="0 0 64 64" width="34" height="34" aria-hidden="true">
                  <defs>
                    <linearGradient id="navBg" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#0B1120"/>
                      <stop offset="100%" stop-color="#020408"/>
                    </linearGradient>
                    <linearGradient id="navQGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#00F2FE"/>
                      <stop offset="45%" stop-color="#38BDF8"/>
                      <stop offset="100%" stop-color="#2563EB"/>
                    </linearGradient>
                    <linearGradient id="navRed" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#FF2E54"/>
                      <stop offset="100%" stop-color="#E11D48"/>
                    </linearGradient>
                    <linearGradient id="navRim" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.45"/>
                      <stop offset="100%" stop-color="#1E293B" stop-opacity="0.2"/>
                    </linearGradient>
                  </defs>
                  <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#navBg)" stroke="url(#navRim)" stroke-width="1.2"/>
                  <circle cx="29" cy="29" r="14.5" fill="none" stroke="url(#navQGrad)" stroke-width="6" stroke-linecap="round"/>
                  <path d="M 27 27 L 46 46" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/>
                  <circle cx="46.5" cy="46.5" r="4.5" fill="url(#navRed)"/>
                  <circle cx="46.5" cy="46.5" r="1.5" fill="#FFFFFF"/>
                </svg>
              </div>
              <div class="brand-text-lockup">
                <span class="brand-kicker">PORTAL TEKNOLOGI NUSANTARA</span>
                <div class="brand-wordmark-row">
                  <span class="brand-word-query">QUERY</span><span class="brand-word-indo">INDO</span>
                  <span class="brand-domain-tag">.COM</span>
                </div>
              </div>
            </a>

            <nav class="header-categories-nav" id="header-categories-nav" aria-label="Kategori Berita Utama">
              <a href="#" class="cat-nav-item active" data-nav-category="all">
                <span class="cat-nav-title">Beranda</span>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="ai">
                <span class="cat-nav-title">AI</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="gadget">
                <span class="cat-nav-title">Gadget</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="software">
                <span class="cat-nav-title">Software</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="startup">
                <span class="cat-nav-title">Startup</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="fintech">
                <span class="cat-nav-title">Fintech</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="ev">
                <span class="cat-nav-title">Mobil Listrik</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="cybersecurity">
                <span class="cat-nav-title">Siber</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="gaming">
                <span class="cat-nav-title">Gaming</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="internet">
                <span class="cat-nav-title">Internet</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="space">
                <span class="cat-nav-title">Antariksa</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="climatetech">
                <span class="cat-nav-title">Tekno Hijau</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="biotech">
                <span class="cat-nav-title">Bioteknologi</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="review">
                <span class="cat-nav-title">Review</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              <a href="#" class="cat-nav-item" data-nav-category="tips">
                <span class="cat-nav-title">Tips</span>
                <svg class="cat-chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
            </nav>
          </div>

          <!-- 3. Rightmost Edge: Search & User Login Icon Buttons ONLY (Mentok Paling Kanan) -->
          <div class="navbar-right-edge">
            <button id="btn-search-toggle" class="btn-search-toggle" onclick="toggleSearchOverlay()" title="Cari Berita (Tekan /)" aria-label="Buka Pencarian" type="button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </button>

            <div class="user-avatar-menu-wrap" id="user-avatar-menu-wrap">
              <button id="user-auth-btn" class="btn-user-avatar" title="Akun & Preferensi Pengguna" aria-label="Akun & Preferensi" aria-expanded="false" aria-haspopup="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </button>

              <div class="user-avatar-dropdown" id="user-avatar-dropdown" style="display: none;">
                <!-- Profile / Auth Section -->
                <div class="dropdown-header-section" id="dropdown-user-header">
                  <div class="dropdown-user-info">
                    <span class="dropdown-user-name" id="dropdown-user-name">Pengunjung Tamu</span>
                    <span class="dropdown-user-role" id="dropdown-user-status">Belum Masuk</span>
                  </div>
                  <button id="dropdown-auth-action-btn" class="dropdown-auth-btn">Masuk / Profil</button>
                </div>

                <div class="dropdown-divider"></div>

                <!-- Bookmarks Item -->
                <button id="dropdown-bookmarks-btn" class="dropdown-item">
                  <div class="dropdown-item-left">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
                    <span>Artikel Tersimpan</span>
                  </div>
                  <span class="dropdown-count-badge" id="dropdown-bookmark-count">0</span>
                </button>

                <!-- Admin CMS Item (Dasbor Redaksi) -->
                <a href="/admin" id="dropdown-admin-cms-btn" class="dropdown-item">
                  <div class="dropdown-item-left">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/><path d="m14 9 3 3-3 3"/></svg>
                    <span>Dasbor Redaksi (CMS)</span>
                  </div>
                </a>

                <div class="dropdown-divider"></div>

                <!-- Theme Toggle Item -->
                <div class="dropdown-item dropdown-theme-row" id="dropdown-theme-row">
                  <div class="dropdown-item-left">
                    <svg id="dropdown-theme-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <span id="dropdown-theme-text">Mode Gelap</span>
                  </div>
                  <button id="dropdown-theme-toggle-btn" class="dropdown-toggle-pill" aria-label="Ubah Tema Mode Gelap/Terang">
                    <span class="toggle-pill-knob"></span>
                  </button>
                </div>

                <!-- Language Switcher Item -->
                <div class="dropdown-item dropdown-lang-row">
                  <div class="dropdown-item-left">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    <span>Bahasa</span>
                  </div>
                  <div class="dropdown-lang-pills" id="dropdown-lang-switcher">
                    <button class="btn-lang-pill active" data-lang="id">ID</button>
                    <button class="btn-lang-pill" data-lang="en">EN</button>
                  </div>
                </div>

                <!-- Logged in Logout item (shown only when logged in) -->
                <div id="dropdown-logout-wrapper" style="display: none;">
                  <div class="dropdown-divider"></div>
                  <button id="dropdown-logout-btn" class="dropdown-item dropdown-logout-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span>Keluar Akun</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Full-Width Mega Menu Container (Height: ~12 cm, approx 440px) -->
      <div id="header-mega-menu" class="header-mega-menu" style="display: none;">
        <div class="mega-menu-inner container">
          <!-- Rendered dynamically on category hover by TypeScript -->
        </div>
      </div>

      <!-- Expandable Search Overlay Bar -->
      <div class="search-overlay-bar" id="search-overlay-bar" style="display: none;">
        <div class="container search-overlay-content">
          <div class="search-box" id="navbar-search-box">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" id="search-input" class="search-input" placeholder="Cari liputan AI, gadget, semikonduktor, startup..." autocomplete="off" />
            <div class="search-actions">
              <button id="btn-filter-toggle" class="btn-filter-icon" title="Filter Lanjutan (Advanced Filter)">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              </button>
              <button id="btn-search-close" class="btn-search-close" title="Tutup Pencarian (Esc)">✕</button>
            </div>
            <div id="search-preview-dropdown" class="search-preview-dropdown" style="display: none;"></div>
          </div>
        </div>
      </div>
      <div id="navbar-scroll-progress" class="navbar-scroll-progress"></div>
    </header>

    <!-- Advanced Filter Expandable Panel -->
    <div id="advanced-filter-panel" class="advanced-filter-panel" style="display:none;">
      <div class="container" style="display:flex; flex-direction:column; gap:0.75rem;">
        <div class="advanced-filter-grid">
          <!-- Sorting Options -->
          <div>
            <label class="filter-group-label" id="lbl-sort-by">Urutkan Berdasarkan</label>
            <select id="filter-sort-by" class="filter-select">
              <option value="latest">Terbaru</option>
              <option value="views">Terpopuler (Dilihat)</option>
              <option value="likes">Paling Disukai</option>
            </select>
          </div>

          <!-- Date Options -->
          <div>
            <label class="filter-group-label" id="lbl-date-range">Rentang Waktu</label>
            <select id="filter-date-range" class="filter-select">
              <option value="all">Semua Waktu</option>
              <option value="24h">24 Jam Terakhir</option>
              <option value="week">Minggu Ini</option>
              <option value="month">Bulan Ini</option>
            </select>
          </div>

          <!-- Filter tags -->
          <div>
            <label class="filter-group-label" id="lbl-popular-tags">Tag Populer</label>
            <div id="filter-tag-chips" class="filter-tag-chips-wrap">
              <!-- Javascript chips -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Layout -->
    <main class="container">
      <!-- ByteShorts Visual Stories Carousel Bar (React Island) -->
      <div id="byteshorts-bar-container">
        <ByteShortsReel client:load />
      </div>

      <!-- [AD SPACE 1] Top Billboard Banner -->
      <div id="top-billboard-ad-container"></div>

      <!-- Hero Section: Featured Article & Sidebar -->
      <section class="section-hero" id="hero-section">
        <div class="hero-grid">
          <!-- Main Hero Featured Article -->
          <div id="featured-article-container">
            <!-- Rendered by JS -->
          </div>

          <!-- Sidebar Trending & Poll -->
          <div class="trending-sidebar">
            <div class="sidebar-header">
              <h2 class="sidebar-title" id="trending-title-header">Populer Minggu Ini</h2>
            </div>
            <div id="trending-articles-container" class="trending-articles-list">
              <!-- Rendered by JS -->
            </div>


          </div>
        </div>
      </section>

      <!-- [SECTION 2] Pilihan Redaksi (Editor's Pick Bento Showcase) -->
      <section class="section-editorial-bento" id="editors-pick-section">
        <div class="section-header-bar">
          <div class="section-header-left">
            <span class="section-indicator-badge">PILIHAN REDAKSI</span>
            <h2 class="section-main-title">Investigasi & Analisis Khusus</h2>
          </div>
          <span class="section-header-subtitle">Laporan mendalam terkurasi oleh dewan redaksi QUERYINDO</span>
        </div>
        <div class="bento-grid" id="editors-pick-container">
          <!-- Rendered by JS -->
        </div>
      </section>

      <!-- [SHOPPING CAROUSEL] Rekomendasi Barang Pilihanmu (Affiliate & E-Commerce Carousel) -->
      <div id="shopping-carousel-container"></div>

      <!-- [AD SPACE 2] Mid-Stream Panoramic Interstitial Banner -->
      <div id="midstream-ad-container"></div>

      <!-- [SECTION 3] Deep Tech & AI Matrix (4-Column Multi-Card Grid) -->
      <section class="section-matrix" id="deep-tech-matrix-section">
        <div class="section-header-bar">
          <div class="section-header-left">
            <span class="section-indicator-badge badge-accent-cyan">DEEP TECH MATRIX</span>
            <h2 class="section-main-title">Kecerdasan Buatan & Semikonduktor</h2>
          </div>
          <span class="section-header-subtitle">Arsitektur model bahasa, akselerator silikon, dan sains masa depan</span>
        </div>
        <div class="matrix-grid" id="deep-tech-matrix-container">
          <!-- Rendered by JS -->
        </div>
      </section>


      <!-- [SECTION 5] Kilas Cepat 24 Jam & Radar Industri / Sidebar Ad (Split-Stream Wire) -->
      <section class="section-rapid-wire" id="rapid-wire-section">
        <div class="wire-split-grid">
          <!-- Left Column: Rapid News Timeline -->
          <div class="wire-timeline-column">
            <div class="wire-header">
              <div class="wire-title-wrap">
                <span class="wire-live-dot"></span>
                <h3 class="wire-main-title">Kilas Berita 24 Jam</h3>
              </div>
              <span class="wire-badge-freq">UPDATE REAL-TIME</span>
            </div>
            <div class="wire-feed-list" id="rapid-wire-container">
              <!-- Rendered by JS -->
            </div>
          </div>

          <!-- Right Column: Hardware Spotlight & [AD SPACE 3] Sidebar Ad Card -->
          <div class="wire-radar-column">
            <div class="wire-header">
              <h3 class="wire-main-title">Radar Produk & Hardware</h3>
              <span class="wire-badge-freq wire-badge-cyan">LAB QUERYINDO</span>
            </div>
            <div class="radar-card-wrap" id="radar-product-container">
              <!-- Rendered by JS -->
            </div>
            <div id="wire-sidebar-ad-container">
              <!-- Rendered by AdBanner component -->
            </div>
          </div>
        </div>
      </section>

      <!-- [SECTION 6] Main Articles Feed Grid (Semua Berita) -->
      <section class="section-feed">
        <!-- Dynamic Leaderboard Ad Banner -->
        <div id="leaderboard-ad-container"></div>

        <div class="section-header">
          <h2 class="section-title" id="feed-title">Semua Berita & Eksplorasi Arsip</h2>
          <span id="results-count" class="feed-results-count">
            <!-- Rendered by JS -->
          </span>
        </div>

        <div class="articles-grid" id="articles-grid">
          <!-- Article Cards Rendered by JS -->
        </div>
        <div id="feed-load-more-container" style="text-align: center; margin-top: 2rem;"></div>
      </section>

    </main>

    <!-- Institutional Full-Page Container (hidden by default) -->
    <div id="institutional-page-container" style="display:none;"></div>

    <!-- Footer (The Verge / Reuters / NYTimes Level Comprehensive Editorial Footer) -->
    <footer class="footer" id="main-footer">
      <div class="container" style="position: relative; z-index: 5;">
        
        <!-- [FOOTER BLOCK 1] Ultra-Minimalist Single-Row Newsletter Subscription Bar -->
        <div class="footer-newsletter-simple" id="footer-newsletter-section">
          <div class="footer-nl-text">
            <span class="footer-nl-label">Langganan Wawasan Tekno:</span>
            <span class="footer-nl-desc">Kurasi riset AI, semikonduktor, dan keamanan siber esensial setiap pagi.</span>
          </div>
          <form class="footer-nl-form" id="footer-newsletter-form">
            <input type="email" class="footer-nl-input" placeholder="Masukkan alamat email..." required />
            <button type="submit" class="footer-nl-btn" id="btn-footer-subscribe">Langganan</button>
          </form>
        </div>

        <!-- [FOOTER BLOCK 2] Brand Identity & Dewan Pers Verification Header -->
        <div class="footer-brand-compliance-row">
          <div class="footer-brand-summary">
            <a href="#" class="brand-logo footer-brand-logo" aria-label="QueryIndo Home">
              <div class="brand-emblem-wrap">
                <svg class="brand-emblem-svg" viewBox="0 0 64 64" width="34" height="34" aria-hidden="true">
                  <rect x="2" y="2" width="60" height="60" rx="16" fill="#0B1120" stroke="rgba(56, 189, 248, 0.4)" stroke-width="1.2"/>
                  <circle cx="29" cy="29" r="14.5" fill="none" stroke="url(#navQGrad)" stroke-width="6" stroke-linecap="round"/>
                  <path d="M 27 27 L 46 46" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/>
                  <circle cx="46.5" cy="46.5" r="4.5" fill="url(#navRed)"/>
                  <circle cx="46.5" cy="46.5" r="1.5" fill="#FFFFFF"/>
                </svg>
              </div>
              <div class="brand-text-lockup">
                <span class="brand-kicker">PORTAL TEKNOLOGI NUSANTARA</span>
                <div class="brand-wordmark-row">
                  <span class="brand-word-query">QUERY</span><span class="brand-word-indo">INDO</span>
                  <span class="brand-domain-tag">.COM</span>
                </div>
              </div>
            </a>
            <p class="footer-editorial-mission">
              QueryIndo adalah media siber jurnalisme teknologi independen nasional yang menyajikan liputan investigatif, riset ilmiah, dan analisis kritis kecerdasan buatan, infrastruktur digital, perangkat keras, dan kedaulatan sains nusantara.
            </p>
            <div class="footer-social-wrapper">
              <span class="footer-social-label">Saluran Resmi:</span>
              <ul class="footer-social-list" id="footer-social-list">
                <!-- Dynamic Official Social Channels from SocialMediaService -->
              </ul>
            </div>
          </div>

          <div class="footer-compliance-clean">
            <div class="compliance-badge-simple">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              <strong>Verifikasi Pedoman Media Siber Dewan Pers</strong>
            </div>
            <p class="compliance-desc">
