---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { InstitutionalPages, type InstitutionalPageId } from '../../components/InstitutionalPages';
import { CATEGORIES, MASTER_TAXONOMY } from '../../data/mockNews';

const categories14 = CATEGORIES.filter(c => c.id !== 'all');

const { slug } = Astro.params;

if (!slug || !InstitutionalPages.isValidPageId(slug)) {
  Astro.response.status = 404;
}

const pageId = slug as InstitutionalPageId;
const isValid = slug && InstitutionalPages.isValidPageId(slug);

const pageTitle = isValid ? InstitutionalPages.getPageTitle(pageId, 'id') : 'Halaman Tidak Ditemukan';
const pageLead = isValid ? InstitutionalPages.getPageLead(pageId, 'id') : '';
const pageKicker = isValid ? InstitutionalPages.getPageKicker(pageId, 'id') : 'Informasi Perusahaan';
const renderedHtml = isValid ? InstitutionalPages.renderPage(pageId, 'id') : '';

// Schema.org Structured Data
const pageSchema = {
  "@context": "https://schema.org",
  "@type": pageId === 'tentang-kami' ? "AboutPage" : pageId === 'hubungi-kami' ? "ContactPage" : "WebPage",
  "name": `${pageTitle} — QUERYINDO`,
  "description": pageLead,
  "url": `https://queryindo.com/page/${slug}`,
  "publisher": {
    "@type": "NewsMediaOrganization",
    "name": "QUERYINDO",
    "url": "https://queryindo.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://queryindo.com/logo.png"
    }
  }
};
---

<BaseLayout
  title={`${pageTitle} — QUERYINDO Portal Berita Teknologi`}
  description={pageLead}
  canonicalUrl={`https://queryindo.com/page/${slug}`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <!-- Standalone Editorial Header Navigation -->
  <header style="background: var(--bg-surface, #0f172a); border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.1)); padding: 12px 24px; position: sticky; top: 0; z-index: 100; backdrop-filter: blur(12px);">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between;">
      <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <div style="width: 32px; height: 32px; border-radius: 8px; background: #0B1120; border: 1.2px solid rgba(56, 189, 248, 0.45); display: flex; align-items: center; justify-content: center;">
          <span style="color: #00F2FE; font-weight: 900; font-size: 1.1rem; font-family: sans-serif;">Q</span>
        </div>
        <div style="display: flex; flex-direction: column;">
          <span style="font-size: 0.58rem; letter-spacing: 1.5px; color: #94a3b8; font-weight: 700;">PORTAL TEKNOLOGI</span>
          <span style="font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif); font-size: 1.15rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; line-height: 1;">
            QUERY<span style="color: var(--brand-cyan, #00f2fe);">INDO</span>
          </span>
        </div>
      </a>

      <div style="display: flex; align-items: center; gap: 12px;">
        <a href="/" style="font-size: 0.85rem; font-weight: 600; color: var(--brand-cyan, #00f2fe); text-decoration: none; display: flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 6px; border: 1px solid rgba(0, 242, 254, 0.25); background: rgba(0, 242, 254, 0.05); transition: all 0.2s ease;">
          &larr; Beranda Portal
        </a>
      </div>
    </div>
  </header>

  <div style="min-height: 80vh; padding: 24px 16px 64px;">
    {isValid ? (
      <div id="institutional-page-ssr-container">
        <Fragment set:html={renderedHtml} />
      </div>
    ) : (
      <div style="max-width: 600px; margin: 80px auto; text-align: center; padding: 0 20px;">
        <h1 style="font-size: 4rem; font-weight: 900; color: var(--brand-cyan, #00f2fe); margin: 0 0 16px;">404</h1>
        <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary, #ffffff); margin: 0 0 12px;">Halaman Tidak Ditemukan</h2>
        <p style="color: var(--text-secondary, #94a3b8); margin-bottom: 24px; line-height: 1.6;">
          Halaman regulasi atau informasi perusahaan <code>{slug}</code> tidak tersedia atau telah dipindahkan.
        </p>
        <a 
          href="/" 
          style="display: inline-block; background: var(--brand-cyan, #00f2fe); color: #000000; padding: 10px 24px; border-radius: 8px; font-weight: 700; text-decoration: none;"
        >
          Kembali ke Beranda
        </a>
      </div>
    )}
  </div>

  <!-- Comprehensive Footer with 14 Categories & 140 Subcategories -->
  <footer class="site-footer" style="background: var(--bg-surface, #0f172a); border-top: 1px solid var(--border-color, rgba(255,255,255,0.1)); padding: 48px 24px 28px;">
    <div class="container footer-container" style="max-width: 1200px; margin: 0 auto;">
      <!-- 14 Categories Directory -->
      <div class="footer-directory-section">
        <div class="footer-directory-grid" id="footer-directory-grid">
          {categories14.map(cat => {
            const subCats = MASTER_TAXONOMY[cat.id] || [];
            return (
              <div class="footer-dir-col-group">
                <a href={`/${cat.id}`} class="footer-dir-cat-title" data-cat={cat.id}>
                  {cat.name}
                </a>
                <div class="footer-dir-subcats-stack">
                  {subCats.map(sub => (
                    <a href={`/${cat.id}?sub=${sub.slug}`} class="footer-dir-subcat-link" data-cat={cat.id} data-subcat={sub.slug}>
                      {sub.name}
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Legal Bottom Strip -->
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; font-size: 0.82rem; color: #94a3b8; padding-top: 24px; border-top: 1px solid var(--border-color, rgba(255,255,255,0.06));">
        <p>© 2026 <strong>QUERYINDO</strong> (PT Inovasi Media Nusantara). Mematuhi UU Pers No. 40/1999 dan Pedoman Media Siber Dewan Pers.</p>
        <div style="display: flex; gap: 16px;">
          <a href="/page/privasi" style="color: inherit; text-decoration: none;">Kebijakan Privasi</a>
          <a href="/page/syarat-ketentuan" style="color: inherit; text-decoration: none;">Syarat & Ketentuan</a>
          <a href="/rss.xml" style="color: inherit; text-decoration: none;">RSS Feed</a>
          <a href="/admin" style="color: inherit; text-decoration: none;">Dasbor Redaksi (CMS)</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    import { InstitutionalPages } from '../../components/InstitutionalPages';

    // Hydrate redaksi page dynamically on client so CMS author changes & deletions reflect immediately
    if (window.location.pathname.includes('/redaksi')) {
      const container = document.getElementById('institutional-page-ssr-container');
      if (container) {
        container.innerHTML = InstitutionalPages.renderPage('redaksi', 'id');
      }
    }

    // Tab scroll arrows and interactions
    document.addEventListener('DOMContentLoaded', () => {
      const navTabs = document.getElementById('inst-nav-tabs');
      const prevBtn = document.getElementById('inst-nav-arrow-prev');
      const nextBtn = document.getElementById('inst-nav-arrow-next');

      if (navTabs) {
        const updateArrows = () => {
          if (prevBtn) {
            prevBtn.style.opacity = navTabs.scrollLeft <= 5 ? '0.35' : '1';
          }
          if (nextBtn) {
            const isEnd = navTabs.scrollLeft + navTabs.clientWidth >= navTabs.scrollWidth - 5;
            nextBtn.style.opacity = isEnd ? '0.35' : '1';
          }
        };

        navTabs.addEventListener('scroll', updateArrows);
        setTimeout(updateArrows, 100);

        prevBtn?.addEventListener('click', () => {
          navTabs.scrollBy({ left: -260, behavior: 'smooth' });
        });
        nextBtn?.addEventListener('click', () => {
          navTabs.scrollBy({ left: 260, behavior: 'smooth' });
        });

        // Center active tab
        const activeTab = navTabs.querySelector('.inst-nav-tab.active');
        if (activeTab) {
          setTimeout(() => {
            activeTab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            updateArrows();
          }, 80);
        }
      }

      // Contact form handler
      const contactForm = document.getElementById('inst-contact-form') as HTMLFormElement | null;
      if (contactForm) {
        contactForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const nameInput = document.getElementById('cf-name') as HTMLInputElement | null;
          const name = nameInput?.value.trim() || 'Pembaca';
          contactForm.reset();
          alert(`Terima kasih, ${name}. Pesan Anda telah kami teruskan ke Meja Redaksi QueryIndo.`);
        });
      }
    });
  </script>
</BaseLayout>
