---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Dasbor Redaksi & CMS — QUERYINDO"
  description="Ruang Kerja Redaksi, Manajemen Berita & Investigasi Jurnalistik QueryIndo."
>
  <div id="admin-cms-viewport" class="admin-cms-fullscreen-viewport" style="width: 100vw; height: 100vh; overflow: hidden; background: var(--bg-primary); position: fixed; inset: 0; z-index: 9999;">
    <div id="admin-cms-container" style="width: 100%; height: 100%;">
      <!-- Rendered dynamically by AdminCMS.ts -->
    </div>
  </div>

  <script>
    import { AdminCMS } from '../components/AdminCMS';

    function initAdminCMS() {
      const container = document.getElementById('admin-cms-container');
      if (!container) return;

      const cms = new AdminCMS(() => {
        // Callback if articles change
      });

      container.innerHTML = cms.renderAdminModalHTML();
      cms.bindAdminEvents(container);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAdminCMS);
    } else {
      initAdminCMS();
    }
  </script>
</BaseLayout>
