---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" style="background: var(--bg-surface, #0b0f19); border-top: 1px solid var(--border-color, rgba(255,255,255,0.08)); padding: 48px 0 32px; margin-top: 60px;">
  <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; margin-bottom: 40px;">
      <!-- Col 1: Brand & Philosophy -->
      <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
          <img src="/logo-brand.svg" alt="QUERYINDO" width="28" height="28" />
          <span style="font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif); font-size: 1.2rem; font-weight: 800; color: var(--text-primary, #ffffff);">
            QUERY<span style="color: var(--brand-cyan, #00f2fe);">INDO</span>
          </span>
        </div>
        <p style="font-size: 0.85rem; line-height: 1.6; color: var(--text-secondary, #94a3b8);">
          Portal jurnalisme teknologi independen nasional. Menyajikan investigasi kecerdasan buatan, semikonduktor, keamanan siber, dan kedaulatan digital Indonesia.
        </p>
      </div>

      <!-- Col 2: Kanal Populer -->
      <div>
        <h4 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-primary, #ffffff); margin-bottom: 14px;">
          Kanal Utama
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.85rem; line-height: 2;">
          <li><a href="/ai" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Kecerdasan Buatan (AI)</a></li>
          <li><a href="/gadget" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Gadget & Hardware</a></li>
          <li><a href="/cybersecurity" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Keamanan Siber</a></li>
          <li><a href="/startup" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Startup & Venture Capital</a></li>
          <li><a href="/software" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Software Engineering</a></li>
        </ul>
      </div>

      <!-- Col 3: Standar Jurnalistik (E-E-A-T) -->
      <div>
        <h4 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-primary, #ffffff); margin-bottom: 14px;">
          Standar Jurnalisme
        </h4>
        <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.85rem; line-height: 2;">
          <li><a href="/page/pedoman-media-siber" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Pedoman Media Siber</a></li>
          <li><a href="/page/kode-etik" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Kode Etik Redaksi</a></li>
          <li><a href="/page/redaksi" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Dewan Redaksi & Wartawan</a></li>
          <li><a href="/page/tentang-kami" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Tentang QUERYINDO</a></li>
          <li><a href="/page/kontak" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Kontak & Siaran Pers</a></li>
        </ul>
      </div>

      <!-- Col 4: Sindikasi & Feeds -->
      <div>
        <h4 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-primary, #ffffff); margin-bottom: 14px;">
          Sindikasi Berita
        </h4>
        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.85rem;">
          <a href="/rss.xml" style="color: var(--brand-cyan, #00f2fe); text-decoration: none;">RSS 2.0 Feed XML</a>
          <a href="/feed.json" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">JSON News Feed</a>
          <a href="/sitemap-news.xml" style="color: var(--text-secondary, #94a3b8); text-decoration: none;">Google News Sitemap</a>
        </div>
      </div>
    </div>

    <div style="border-top: 1px solid var(--border-color, rgba(255,255,255,0.06)); padding-top: 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; font-size: 0.8rem; color: var(--text-muted, #64748b);">
      <p style="margin: 0;">
        &copy; {currentYear} <strong>QUERYINDO MEDIA SIBER</strong>. Seluruh Hak Cipta Dilindungi Undang-Undang.
      </p>
      <div style="display: flex; gap: 16px;">
        <a href="/page/kebijakan-privasi" style="color: inherit; text-decoration: none;">Privasi</a>
        <a href="/page/syarat-ketentuan" style="color: inherit; text-decoration: none;">Ketentuan</a>
        <a href="/page/pedoman-hak-cipta" style="color: inherit; text-decoration: none;">Hak Cipta</a>
      </div>
    </div>
  </div>
</footer>
